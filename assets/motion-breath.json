        {
          "start": 0,
          "label": "Inspiration",
          "detail": "The diaphragm contracts and its domes descend. Rib rotation widens and deepens the thorax. Different intercostal regions have different roles.",
          "active": [
            "diaphragm"
          ],
          "opposes": []
        },
        {
          "start": 1.8,
          "label": "End of inspiration",
          "detail": "Compare the lower dome and expanded rib cage with the start of the breath.",
          "active": [],
          "opposes": []
        },
        {
          "start": 2.02,
          "label": "Passive expiration",
          "detail": "The diaphragm relaxes and the chest wall recoils. The abdominal wall follows along in this quiet-breathing example.",
          "active": [],
          "opposes": []
        }
      ]
    },
