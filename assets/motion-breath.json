      "name": "External intercostal muscles",
      "side": "right",
      "role": "external-intercostals",
      "note": "Move with the adjacent ribs. Region-specific inspiratory contribution varies with task and interspace.",
      "modeling": "authored-deformation"
    },
    {
      "id": "muscle-internal-intercostal-muscles-r",
      "name": "Internal intercostal muscles",
      "side": "right",
      "role": "internal-intercostals",
      "note": "The parasternal portion assists inspiration, while many interosseous portions assist expiration. This mesh groups them.",
      "modeling": "authored-deformation"
    },
